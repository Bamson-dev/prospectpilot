generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum CampaignStatus {
  DRAFT
  DISCOVERY
  RESEARCHING
  READY
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum OpportunityFocus {
  SOFTWARE
  ADVERTISING
  SOFTWARE_AND_ADVERTISING
  AUTOMATION
  OTHER
}

enum EmailProviderKind {
  RESEND
  GMAIL
}

enum DiscoveryStatus {
  NEW
  QUEUED
  FOUND
  FAILED
}

enum ResearchStatus {
  PENDING
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum QualificationStatus {
  UNREVIEWED
  QUALIFIED
  REJECTED
  APPROVED
  SKIPPED
}

enum OutreachState {
  NONE
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  QUEUED
  SENDING
  SENT
  DELIVERED
  OPENED
  FAILED
  REPLIED
  CANCELLED
  SUPPRESSED
}

enum ReplyClass {
  UNCLASSIFIED
  INTERESTED
  NOT_INTERESTED
  QUESTION
  PRICING_REQUEST
  MEETING_REQUEST
  NOT_NOW
  WRONG_PERSON
  UNSUBSCRIBE
  OUT_OF_OFFICE
  OTHER
}

enum FollowUpState {
  PENDING_APPROVAL
  SCHEDULED
  QUEUED
  SENT
  SKIPPED
  CANCELLED
  FAILED
}

enum AccountStatus {
  ACTIVE
  ERROR
  RESTRICTED
}

enum JobState {
  QUEUED
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  CANCELLED
}

enum OpportunityKind {
  SOFTWARE
  ADVERTISING
  AUTOMATION
  OTHER
  CUSTOM_SOFTWARE
  SOFTWARE_REPLACEMENT
  ADVERTISING_MANAGEMENT
  ADVERTISING_OPTIMIZATION
}

enum OpportunityStatus {
  OPEN
  DISMISSED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  activity     ActivityLog[]
}

model Organization {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  memberships   Membership[]
  campaigns     Campaign[]
  prospects     Prospect[]
  contacts      Contact[]
  emailAccounts EmailAccount[]
  suppressions  Suppression[]
  jobs          BackgroundJob[]
  activity      ActivityLog[]
  settings      Setting[]
  aiRequests    AIRequest[]
  conversations Conversation[]
  tags          Tag[]
  sequences     Sequence[]
  discoverySources DiscoverySource[]
  candidates    Candidate[]
  jobVacancies  JobVacancy[]
  jobApplications JobApplication[]
  generatedDocuments GeneratedDocument[]
  candidateDocuments CandidateDocument[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Campaign {
  id                   String           @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  industry             String?
  country              String?
  city                 String?
  searchTerms          String
  opportunityFocus     OpportunityFocus @default(SOFTWARE_AND_ADVERTISING)
  targetCompanySize    String?
  dailyDiscoveryLimit  Int              @default(25)
  dailyResearchLimit   Int              @default(25)
  dailyQualificationLimit Int           @default(25)
  dailyOutreachLimit   Int              @default(25)
  excludedKeywords     String?
  maxQueries           Int              @default(6)
  maxPagesPerSite      Int              @default(10)
  crawlDepth           Int              @default(2)
  enableDirectory      Boolean          @default(false)
  enableMap            Boolean          @default(false)
  enableSocial         Boolean          @default(false)
  provider             EmailProviderKind?
  emailAccountId       String?
  requireApproval      Boolean          @default(true)
  autoFollowUp         Boolean          @default(false)
  followUpSteps        Json
  status               CampaignStatus   @default(DRAFT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emailAccount         EmailAccount?    @relation(fields: [emailAccountId], references: [id])
  prospects            Prospect[]
  jobs                 BackgroundJob[]
  activity             ActivityLog[]
  messages             OutreachMessage[]
  followUps            FollowUp[]
  sequences            Sequence[]
  discoverySources     DiscoverySource[]

  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
}

model Prospect {
  id                      String                @id @default(cuid())
  organizationId          String
  campaignId              String?
  companyName             String
  domain                  String?
  website                 String?
  industry                String?
  country                 String?
  city                    String?
  address                 String?
  phone                   String?
  linkedinUrl             String?
  facebookUrl             String?
  instagramUrl            String?
  description             String?
  companySize             String?
  source                  String
  sourceUrl               String?
  discoveryStatus         DiscoveryStatus       @default(NEW)
  researchStatus          ResearchStatus        @default(PENDING)
  qualificationStatus     QualificationStatus   @default(UNREVIEWED)
  outreachState           OutreachState         @default(NONE)
  softwareOpportunity     Int?
  advertisingOpportunity  Int?
  automationOpportunity   Int?
  opportunityScore        Int?
  opportunityReason       String?
  researchSummary         String?
  painPoints              String[]
  recommendedService      String?
  personalizationAngle    String?
  suggestedOpening        String?
  notes                   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign                Campaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contacts                Contact[]
  research                ResearchRecord[]
  opportunities           OpportunityAssessment[]
  messages                OutreachMessage[]
  conversations           Conversation[]
  activity                ActivityLog[]
  jobs                    BackgroundJob[]
  aiRequests              AIRequest[]
  tags                    ProspectTag[]
  sources                 DiscoverySource[]

  @@unique([organizationId, domain])
  @@index([organizationId, qualificationStatus])
  @@index([organizationId, outreachState])
  @@index([organizationId, updatedAt])
  @@index([campaignId, createdAt])
}

model DiscoverySource {
  id             String   @id @default(cuid())
  organizationId String
  prospectId     String?
  campaignId     String?
  sourceType     String
  sourceName     String
  sourceUrl      String
  query          String?
  title          String?
  snippet        String?
  confidence     Int      @default(50)
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect       Prospect?    @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([prospectId, createdAt])
  @@index([organizationId, sourceType])
}

model SourceHealth {
  id            String    @id @default(cuid())
  name          String    @unique
  status        String
  requests      Int       @default(0)
  successes     Int       @default(0)
  failures      Int       @default(0)
  blocked       Int       @default(0)
  emptyResults  Int       @default(0)
  lastError     String?
  lastSuccessAt DateTime?
  updatedAt     DateTime  @updatedAt
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  prospectId     String
  firstName      String?
  lastName       String?
  fullName       String?
  jobTitle       String?
  email          String?
  phone          String?
  linkedinUrl    String?
  source         String
  sourceUrl      String?
  confidence     Int          @default(0)
  isPrimary      Boolean      @default(false)
  suppressed     Boolean      @default(false)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect       Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  messages       OutreachMessage[]
  replies        Reply[]
  activity       ActivityLog[]

  @@index([organizationId, email])
  @@index([prospectId, isPrimary])
}

model ResearchRecord {
  id              String   @id @default(cuid())
  prospectId      String
  url             String
  fetchMethod     String
  title           String?
  metaDescription String?
  excerpt         String?
  headings        String[]
  signals         Json
  sourceType      String   @default("website")
  content         String?  @db.Text
  technologies    String[] @default([])
  services        String[] @default([])
  products        String[] @default([])
  contactSignals  Json?
  advertisingSignals Json?
  softwareSignals Json?
  socialLinks     Json?
  bookingSignals  Json?
  trackingSignals Json?
  confidence      Int?
  createdAt       DateTime @default(now())
  prospect        Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

model OpportunityAssessment {
  id                 String          @id @default(cuid())
  prospectId         String
  kind               OpportunityKind
  evidence           Json
  interpretation     String
  recommendedService String?
  confidence         Int
  title              String?
  description        String?
  potentialValue     String?
  status             OpportunityStatus @default(OPEN)
  createdAt          DateTime        @default(now())
  prospect           Prospect        @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, kind])
}

model EmailAccount {
  id                    String            @id @default(cuid())
  organizationId        String
  provider              EmailProviderKind
  fromEmail             String
  fromName              String?
  refreshTokenEncrypted String?
  status                AccountStatus     @default(ACTIVE)
  lastError             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns             Campaign[]

  @@index([organizationId, provider])
}

model Conversation {
  id             String            @id @default(cuid())
  organizationId String
  prospectId     String
  subject        String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect       Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  messages       OutreachMessage[]
  replies        Reply[]
  notes          ConversationNote[]

  @@index([organizationId, updatedAt])
}

model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model OutreachMessage {
  id             String         @id @default(cuid())
  organizationId String
  campaignId     String?
  prospectId     String
  contactId      String?
  conversationId String?
  subject        String
  body           String
  state          OutreachState  @default(DRAFT)
  provider       EmailProviderKind?
  providerMessageId String?
  error          String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  openedAt       DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  prospect       Prospect       @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  followUps      FollowUp[]

  @@index([prospectId, state])
  @@index([campaignId, state])
  @@index([providerMessageId])
}

model Reply {
  id                 String      @id @default(cuid())
  organizationId     String
  conversationId     String
  prospectId         String
  contactId          String?
  fromEmail          String?
  subject            String?
  body               String
  receivedAt         DateTime    @default(now())
  classification     ReplyClass  @default(UNCLASSIFIED)
  classificationNote String?
  suggestedSubject   String?
  suggestedBody      String?
  confidence         Int?
  createdAt          DateTime    @default(now())
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact            Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([conversationId, receivedAt])
  @@index([prospectId, classification])
}

model FollowUp {
  id             String        @id @default(cuid())
  organizationId String
  campaignId     String
  prospectId     String
  messageId      String?
  dayOffset      Int
  subject        String
  body           String
  state          FollowUpState @default(PENDING_APPROVAL)
  runAt          DateTime?
  error          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  campaign       Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  message        OutreachMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([state, runAt])
  @@index([campaignId, state])
  @@index([prospectId])
}

model Suppression {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  reason         String
  source         String
  notes          String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId, email])
}

model BackgroundJob {
  id             String       @id @default(cuid())
  organizationId String
  campaignId     String?
  prospectId     String?
  queue          String
  name           String
  state          JobState     @default(QUEUED)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  error          String?
  payload        Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  prospect       Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([organizationId, state])
  @@index([queue, state])
  @@index([campaignId])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  campaignId     String?
  prospectId     String?
  action         String
  detail         String?
  userId         String?
  contactId      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  prospect       Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@index([prospectId, createdAt])
  @@index([campaignId, createdAt])
}

model AIRequest {
  id             String       @id @default(cuid())
  organizationId String
  prospectId     String?
  purpose        String
  promptVersion  String
  model          String
  inputHash      String
  status         String
  error          String?
  durationMs     Int?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect       Prospect?    @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([organizationId, purpose, inputHash])
  @@index([prospectId, createdAt])
}

model Setting {
  id             String       @id @default(cuid())
  organizationId String
  key            String
  value          String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospects      ProspectTag[]

  @@unique([organizationId, name])
}

model ProspectTag {
  prospectId String
  tagId      String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([prospectId, tagId])
  @@index([tagId])
}

model Sequence {
  id             String         @id @default(cuid())
  organizationId String
  campaignId     String
  name           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  steps          SequenceStep[]

  @@index([organizationId, campaignId])
}

model SequenceStep {
  id         String   @id @default(cuid())
  sequenceId String
  position   Int
  dayOffset  Int
  subject    String
  body       String
  sequence   Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, position])
}

enum CareerProfileKind {
  SOFTWARE
  WEB
  MARKETING
  SAAS
  GROWTH
  FOUNDER
  HYBRID
}

enum FactCategory {
  IDENTITY
  EXPERIENCE
  ACHIEVEMENT
  SKILL
  TECHNOLOGY
  CERTIFICATION
  EDUCATION
  METRIC
  PROJECT
  LINK
}

enum RequirementKind {
  MUST_HAVE
  NICE_TO_HAVE
  RESPONSIBILITY
  TECHNOLOGY
  SOFT_SKILL
  EDUCATION
  EXPERIENCE_YEARS
  SENIORITY
  INDUSTRY
  LOCATION
  REMOTE_POLICY
  EMPLOYMENT_TYPE
  SALARY
  APPLICATION_METHOD
  APPLICATION_PLATFORM
}

enum JobVacancyStatus {
  DISCOVERED
  ANALYZED
  QUALIFIED
  REJECTED
  DUPLICATE
  ARCHIVED
}

enum FactSourceType {
  CANDIDATE_ENTERED
  REPOSITORY_VERIFIED
  DOCUMENT_VERIFIED
  SYSTEM_GENERATED
}

enum ApplicationPackageStatus {
  PREPARED
  READY_FOR_REVIEW
  REQUIRES_REVIEW
  READY_TO_SUBMIT
  SUBMITTING
  SUBMITTED
  VERIFICATION_REQUIRED
  FAILED
  REQUIRES_MANUAL_ACTION
  WITHDRAWN
  APPROVED
  REJECTED
  VERIFIED
  PREPARING
  FIT_EVALUATED
  READY_FOR_SUBMISSION
  VERIFICATION_PENDING
}

enum ApplicationEventType {
  JOB_FOUND
  JOB_ANALYZED
  FIT_CALCULATED
  CV_GENERATED
  COVER_LETTER_GENERATED
  APPLICATION_OPENED
  FORM_STARTED
  CV_UPLOADED
  QUESTIONS_FILLED
  SUBMISSION_STARTED
  SUBMITTED
  VERIFICATION_PASSED
  VERIFICATION_FAILED
  CAPTCHA_DETECTED
  RATE_LIMITED
  MANUAL_ACTION_REQUIRED
  PACKAGE_PREPARED
  BROWSER_OPENED
  FIELDS_CLASSIFIED
  QUESTIONS_GENERATED
  APPROVED
  REJECTED
}

enum GeneratedDocumentKind {
  CV
  COVER_LETTER
  SUPPORTING
}

enum CandidateDocumentKind {
  BASE_CV
  PORTFOLIO
  CERTIFICATE
  OTHER
}

enum ApplicationQuestionKind {
  EXPERIENCE
  MOTIVATION
  SALARY
  LOCATION
  WORK_AUTHORIZATION
  AVAILABILITY
  TECHNICAL
  BEHAVIORAL
  COMPANY_SPECIFIC
  PORTFOLIO
  EDUCATION
  OTHER
}

model Candidate {
  id             String   @id @default(cuid())
  organizationId String
  fullName       String
  firstName      String
  lastName       String
  email          String
  phone          String?
  location       String?
  headline       String?
  linkedinUrl    String?
  portfolioUrl   String?
  githubUrl      String?
  yearsExperience Int?
  currentRole    String?
  targetRoles    String[] @default([])
  workAuthorization String?
  sponsorship    String?
  availability   String?
  noticePeriod   String?
  employmentPreference String?
  remotePreference String?
  relocationPreference String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profiles       CandidateCareerProfile[]
  experiences    CandidateExperience[]
  projects       CandidateProject[]
  facts          CandidateFact[]
  education      CandidateEducation[]
  certifications CandidateCertification[]
  writing        CandidateWritingProfile?
  preference     CandidatePreference?
  documents      GeneratedDocument[]
  baseDocuments  CandidateDocument[]
  applications   JobApplication[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model CandidateCareerProfile {
  id          String            @id @default(cuid())
  candidateId String
  kind        CareerProfileKind
  title       String
  summary     String
  candidate   Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, kind])
}

model CandidateExperience {
  id          String    @id @default(cuid())
  candidateId String
  title       String
  organizationName String
  summary     String
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  verified    Boolean   @default(false)
  source      String
  profiles    CareerProfileKind[]
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateProject {
  id           String   @id @default(cuid())
  candidateId  String
  name         String
  description  String
  role         String
  industry     String?
  projectType  String?
  technologies String[] @default([])
  features     String[] @default([])
  responsibilities String[] @default([])
  outcomes     String[] @default([])
  metrics      String[] @default([])
  url          String?
  githubUrl    String?
  demoUrl      String?
  videoUrl     String?
  verified     Boolean  @default(false)
  source       String
  profiles     CareerProfileKind[]
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@index([candidateId])
}

model CandidateFact {
  id             String            @id @default(cuid())
  candidateId    String
  category       FactCategory
  subcategory    String?
  fact           String
  source         String
  sourceType     FactSourceType    @default(CANDIDATE_ENTERED)
  sourceDocumentId String?
  verified       Boolean           @default(false)
  confidence     Int               @default(0)
  startDate      DateTime?
  endDate        DateTime?
  profiles       CareerProfileKind[]
  industries     String[]          @default([])
  roles          String[]          @default([])
  skills         String[]          @default([])
  technologies   String[]          @default([])
  keywords       String[]          @default([])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, category, fact])
  @@index([candidateId, category])
}

model CandidateWritingProfile {
  id          String   @id @default(cuid())
  candidateId String   @unique
  tone        String
  formality   String
  verbosity   String
  voice       String
  samples     String[] @default([])
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidatePreference {
  id              String   @id @default(cuid())
  candidateId     String   @unique
  discoverJobs    Boolean  @default(false)
  dailyTarget     Int      @default(500)
  mode            String   @default("AUTO_PREPARE")
  locations       String[] @default([])
  remoteOnly      Boolean  @default(false)
  salaryMin       Int?
  salaryTarget    Int?
  salaryCurrency  String?
  salaryPeriod    String?
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CandidateEducation {
  id          String    @id @default(cuid())
  candidateId String
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  source      String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model CandidateCertification {
  id           String    @id @default(cuid())
  candidateId  String
  name         String
  issuer       String?
  issuedAt     DateTime?
  credentialUrl String?
  source       String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model JobVacancy {
  id                 String           @id @default(cuid())
  organizationId     String
  source             String
  sourceUrl          String
  applicationUrl     String
  externalId         String?
  companyName        String
  companyDomain      String?
  companyDescription String?
  title              String
  location           String?
  country            String?
  remoteType         String?
  employmentType     String?
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?
  description        String           @db.Text
  seniority          String?
  industry           String?
  postedAt           DateTime?
  deadline           DateTime?
  discoveredAt       DateTime         @default(now())
  status             JobVacancyStatus @default(DISCOVERED)
  duplicateOf        String?
  rawData            Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements       JobRequirement[]
  fit                JobFitSnapshot?
  applications       JobApplication[]
  documents          GeneratedDocument[]

  @@unique([organizationId, applicationUrl])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, externalId])
  @@index([companyDomain])
}

model JobRequirement {
  id          String          @id @default(cuid())
  vacancyId   String
  kind        RequirementKind
  text        String
  years       Int?
  required    Boolean         @default(false)
  vacancy     JobVacancy      @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId, kind])
}

model JobFitSnapshot {
  id                String   @id @default(cuid())
  vacancyId         String   @unique
  candidateId       String
  profile           CareerProfileKind
  overallMatch      Int
  profileMatch      Int
  missing           Json
  evidence          Json
  gaps              Json
  advantages        Json
  recommendation    String
  analysis          Json?
  selectedProjectIds String[] @default([])
  selectedFactIds   String[] @default([])
  createdAt         DateTime @default(now())
  vacancy           JobVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
}

model GeneratedDocument {
  id             String                @id @default(cuid())
  organizationId String
  candidateId    String
  vacancyId      String?
  profile        CareerProfileKind?
  kind           GeneratedDocumentKind
  version        Int                   @default(1)
  fileName       String
  fileType       String
  checksum       String
  text           String                @db.Text
  content        Bytes
  archived       Boolean               @default(false)
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancy        JobVacancy?           @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  @@index([organizationId, candidateId, kind, createdAt])
  @@index([vacancyId])
}

model ApplicationPackage {
  id             String                   @id @default(cuid())
  applicationId  String                   @unique
  profile        CareerProfileKind
  fitSummary     String
  strategy       String
  status         ApplicationPackageStatus @default(PREPARED)
  version        Int                      @default(1)
  warnings       String[]                 @default([])
  timings        Json?
  application    JobApplication           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model CandidateDocument {
  id             String                @id @default(cuid())
  organizationId String
  candidateId    String
  kind           CandidateDocumentKind
  fileName       String
  fileType       String
  checksum       String
  content        Bytes
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate             @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, candidateId, kind])
}

model JobApplication {
  id              String                   @id @default(cuid())
  organizationId  String
  candidateId     String
  vacancyId       String
  profile         CareerProfileKind
  status          ApplicationPackageStatus @default(PREPARED)
  source          String
  applicationUrl  String
  cvId            String?
  coverLetterId   String?
  submittedAt     DateTime?
  verifiedAt      DateTime?
  failureReason   String?
  blockedReason   String?
  retryCount      Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate       Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancy         JobVacancy               @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  package         ApplicationPackage?
  events          ApplicationEvent[]
  answers         ApplicationAnswer[]
  followUps       ApplicationFollowUp[]

  @@unique([organizationId, vacancyId, candidateId])
  @@index([organizationId, status, createdAt])
  @@index([applicationUrl])
}

model ApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  type          ApplicationEventType
  detail        String?
  createdAt     DateTime             @default(now())
  application   JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationAnswer {
  id            String                  @id @default(cuid())
  applicationId String
  question      String
  kind          ApplicationQuestionKind
  answer        String?
  status        String
  application   JobApplication          @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ApplicationFollowUp {
  id            String   @id @default(cuid())
  applicationId String
  runAt         DateTime
  channel       String
  status        String   @default("DRAFT")
  draft         String
  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, runAt])
}
